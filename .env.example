# URL de tu proyecto en Supabase (Settings -> API -> Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (Settings -> API -> Project API Keys -> anon public)
SUPABASE_ANON_KEY=tu-clave-anon-aqui

# Prefijos compatibles si se utiliza Vite o frameworks modernos
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-aqui
